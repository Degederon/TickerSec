{
  "name": "tickersec",
  "productName": "TickerSec",
  "version": "2.8.3",
  "description": "TickerSec \u2014 Breaking News feeds: live headlines from the sources you choose, scrolling in glass ticker bars across your desktop.",
  "main": "main.js",
  "author": "Jay Appell",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm test && sh build/clean-env.sh npx electron-builder --win nsis --x64 && node build/make-release.js",
    "test": "node test/parse.test.js && node test/alerts.test.js && node test/update-guard.test.js",
    "check-feeds": "node test/check-feeds.js",
    "release": "node build/make-release.js"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jayappell.tickersec",
    "publish": null,
    "productName": "TickerSec",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "icon.svg",
      "build/icon-off.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TickerSec",
      "artifactName": "TickerSec Setup ${version}.${ext}",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "guid": "d7d280aa-2c53-5307-870e-c2c5308f9a5b"
    },
    "copyright": "Copyright \u00a9 2026 Jay Appell"
  }
}
